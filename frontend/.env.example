# SmartGridAI frontend configuration.
# Copy to `.env` and adjust. `VITE_`-prefixed variables are exposed to the client.

# Base URL of the Phase 7 FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Polling interval (ms) for live weather + current consumption on the Dashboard.
VITE_LIVE_REFRESH_MS=60000