# ---------------------------------------------------------------------------
# SmartGridAI - Phase 1 environment configuration
# Copy this file to `.env` and adjust as needed. Do NOT commit `.env`.
# ---------------------------------------------------------------------------

# Kaggle credentials (optional for public datasets; required if the dataset is
# gated or kagglehub refuses unauthenticated downloads).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Dataset selection
KAGGLE_DATASET=nicholasjhana/energy-consumption-generation-prices-and-weather
RAW_FILE=energy_dataset.csv
TIMESTAMP_COLUMN=time
TARGET_COLUMN=total load actual

# Expected sampling frequency (pandas offset alias)
FREQUENCY=h

# Data directories (relative to project root)
DATA_DIR=ml/data
RAW_DIR=ml/data/raw
PROCESSED_DIR=ml/data/processed

# Validation thresholds
MIN_RECORDS=20000

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 2 (feature engineering + baseline forecasting)
# ---------------------------------------------------------------------------

# Chronological split ratios (must sum to 1.0). Applied after dropping the
# leading 168h warm-up window required by the widest lag/rolling features.
TRAIN_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15

# Window (hours) used by the moving-average baseline.
MA_WINDOW=24

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 3 (ML forecasting)
# ---------------------------------------------------------------------------

# Directory holding serialized model artifacts.
MODELS_DIR=ml/models

# Reproducibility seed for every model/split.
RANDOM_STATE=42

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 4 (weather-aware forecasting)
# ---------------------------------------------------------------------------

# Open-Meteo location (stand-in for the ENTSO-E Spain load area) + timezone.
WEATHER_LATITUDE=40.4168
WEATHER_LONGITUDE=-3.7038
WEATHER_TIMEZONE=Europe/Madrid

# Open-Meteo hourly variables requested from the archive API.
# WEATHER_VARIABLES=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m,weather_code

# Number of days of forecast to fetch (current + N-day hourly forecast).
WEATHER_FORECAST_DAYS=7

# Phase 4.1: refresh the persisted weather snapshot automatically after this
# many hours so household forecasts always use their best available weather.
# Higher = fewer external fetches; missing/stale snapshots trigger a refresh.
WEATHER_REFRESH_HOURS=6

# Historical weather fetch window (padded beyond the consumption period so the
# weather-feature merge has 100% coverage).
WEATHER_START_DATE=2015-01-01
WEATHER_END_DATE=2019-01-01

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 5 (peak-hour analysis + anomaly detection)
# ---------------------------------------------------------------------------

# Percentile used to define "peak" hours.
PEAK_PERCENTILE=95

# Hour-of-day windows defining the morning and evening peak bands.
MORNING_START_HOUR=6
MORNING_END_HOUR=11
EVENING_START_HOUR=17
EVENING_END_HOUR=22

# Night hours treated specially for abnormal-nighttime-usage detection.
NIGHT_START_HOUR=0
NIGHT_END_HOUR=6

# Iterated forecast horizon (days) for predicted future peak periods.
PEAK_FORECAST_DAYS=14

# Anomaly detection configuration.
ANOMALY_ROLLING_WINDOW=168
ANOMALY_ZSCORE_CUTOFF=3.0
ANOMALY_NIGHT_ZSCORE_CUTOFF=3.0
ANOMALY_IF_CONTAMINATION=0.01
ANOMALY_IF_N_ESTIMATORS=200

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 6 (electricity bill + tariff engine)
# ---------------------------------------------------------------------------

# Directory holding tariff definitions (ml/tariffs/*.json).
TARIFFS_DIR=ml/tariffs

# Directory holding household bill-simulator tariffs (ml/household_tariffs/*.json).
# These are per-kWh residential tariffs, kept separate from the regional ones.
HOUSEHOLD_TARIFFS_DIR=ml/household_tariffs

# Scope identifiers used to label every bill result (report + future API).
SCOPE_REGIONAL_GRID=regional_grid
SCOPE_HOUSEHOLD=household
SCOPE_REGIONAL_LABEL=Regional Grid Energy Cost
SCOPE_HOUSEHOLD_LABEL=Household Bill Simulator

# Default tariff used when --tariff is not given.
DEFAULT_TARIFF=time_of_use

# Default currency symbol shown in bill reports.
CURRENCY_SYMBOL=INR

# Hours per period used for the "monthly estimated bill" projection.
MONTHLY_ESTIMATE_HOURS=720

# Peak-to-off-peak shift percentage for the savings what-if (%). 0 disables.
PEAK_SHIFT_PERCENT=10.0

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 7 (FastAPI backend)
# ---------------------------------------------------------------------------

# Host/port the uvicorn server binds to.
API_HOST=127.0.0.1
API_PORT=8000

# URL prefix for all API routes.
API_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins. Use * to allow any origin.
CORS_ORIGINS=*

# Logging level for the API process (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# Default tariff + forecast horizon used by regional bill endpoints.
API_DEFAULT_TARIFF=time_of_use
API_DEFAULT_HORIZON=1m

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 9 (Agentic AI Energy Analyst)
# ---------------------------------------------------------------------------

# Provider-agnostic LLM configuration. API keys live ONLY in the backend .env
# and are never exposed to the frontend. Never commit a real key.
#
#   LLM_PROVIDER=mock                # keyless deterministic demo/test provider
#   LLM_PROVIDER=openai_compatible   # any OpenAI-compatible /chat/completions
#                                    # endpoint (OpenAI, Groq, OpenRouter,
#                                    # LM Studio, Ollama, ...)
#   LLM_PROVIDER=openai              # alias for openai_compatible
LLM_PROVIDER=mock

# Model id sent by the OpenAI-compatible provider (ignored by mock).
LLM_MODEL=

# Secret API key. Empty with LLM_PROVIDER=openai_compatible -> the endpoint
# returns AGENT_NOT_CONFIGURED (503) with operator guidance.
LLM_API_KEY=

# Base URL for OpenAI-compatible providers.
LLM_BASE_URL=https://api.openai.com/v1

# Per-attempt request timeout (seconds).
LLM_TIMEOUT_S=60

# Maximum tool-calling rounds the agent may use before producing an answer.
AGENT_MAX_TOOL_ROUNDS=5

# Conversation context TTL (seconds) for the lightweight in-memory store.
AGENT_CONVERSATION_TTL_S=3600

# Maximum chat message length (characters).
AGENT_MAX_MESSAGE_CHARS=2000

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 11 (user upload + flexible forecasting workspace)
# ---------------------------------------------------------------------------

# Directory holding uploaded consumption datasets (gitignored, ml/data/*).
UPLOAD_DIR=ml/data/uploads

# Maximum accepted upload size (MB) and allowed file extensions.
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx

# Dataset retention TTL (seconds) + max number of cached datasets.
UPLOAD_TTL_S=86400
MAX_DATASETS=32

# Forecast horizon bounds (days) and strategy boundaries.
#   short_term  : 1-horizon_days_lt SHORT_TERM_MAX_DAYS  (ML model on your data)
#   medium_term : > SHORT_TERM_MAX_DAYS up to MEDIUM_TERM_MAX_DAYS (seasonal)
#   long_term   : > MEDIUM_TERM_MAX_DAYS up to MAX_FORECAST_DAYS (seasonal+aggregated)
MAX_FORECAST_DAYS=730
SHORT_TERM_MAX_DAYS=7
MEDIUM_TERM_MAX_DAYS=180

# LOW / MEDIUM / HIGH classification percentiles (from the uploaded history).
LOW_PERCENTILE=33
HIGH_PERCENTILE=66

# Minimum historical history (days) before long/medium-term forecasts are
# labeled reliable in warnings.
LONG_TERM_MIN_HISTORY_DAYS=90
MEDIUM_TERM_MIN_HISTORY_DAYS=30

# ---------------------------------------------------------------------------
# SmartGridAI - Phase 12 (festival / holiday-aware forecasting)
# ---------------------------------------------------------------------------

# Number of days before and after each festival day that make up its "window".
FESTIVAL_WINDOW_BEFORE=3
FESTIVAL_WINDOW_AFTER=3

# Minimum in-window historical observations before a household-specific
# festival effect is estimated/applied. Below this the effect is reported as
# "insufficient data" and the forecast is left untouched.
FESTIVAL_MIN_OBSERVATIONS=12

# +/- percent band used to classify the observed effect vs the household's own
# baseline: beyond it the effect is HIGHER/LOWER, inside it SIMILAR.
FESTIVAL_EFFECT_THRESHOLD_PCT=10.0

# Optional JSON file that replaces festivals' built-in dates, e.g. for
# state/region-specific accuracy. Format: {"Festival Name": {"2025": [3, 14]}}.
FESTIVAL_CALENDAR_JSON=
